# =====================================================
# SMART PARKING SYSTEM - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your values

# =====================================================
# BACKEND CONFIGURATION
# =====================================================

# MongoDB Connection String
# For local development: mongodb://localhost:27017/smart-parking
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smart-parking?appName=Cluster0
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/Smart-Parking?appName=Cluster0

# Server Port (Render/Vercel will override this)
PORT=5000

# Node Environment
# Values: development, production
NODE_ENV=production

# API Base URL (for CORS and client-server communication)
# For local: http://localhost:5000
# For production: https://your-render-backend.onrender.com
API_BASE_URL=https://your-render-backend.onrender.com

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================

# React App API URL (used by client/src in build time)
# This is consumed by Vercel frontend to communicate with backend
REACT_APP_API_URL=https://your-render-backend.onrender.com/api

# =====================================================
# MOBILE APP CONFIGURATION
# =====================================================

# Mobile API Base URL (hardcoded in parking-mobile-app/App.js for now)
# Update parking-mobile-app/App.js line: const API_URL = '...'
# MOBILE_API_URL=https://your-render-backend.onrender.com

# =====================================================
# OPTIONAL: PRODUCTION CREDENTIALS & SECRETS
# =====================================================

# Add these when deploying to production:
# - JWT_SECRET (if implementing token auth)
# - CORS_ORIGIN (for stricter CORS)
# - DB_POOL_SIZE (for production connections)
