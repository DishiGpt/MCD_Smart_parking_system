# =====================================================
# SMART PARKING SYSTEM - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your values

# =====================================================
# BACKEND CONFIGURATION
# =====================================================

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/smart-parking

# Server Port (Render/Vercel will override this)
PORT=5000

# Node Environment
NODE_ENV=development

# API Base URL (for CORS and client-server communication)
API_BASE_URL=http://localhost:5000

# Administrative Credentials (Checked Server-Side)
ADMIN_ID=admin
ADMIN_PASSWORD=admin123

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================

# React App API URL (used by client/src in build time)
REACT_APP_API_URL=http://localhost:5000/api
